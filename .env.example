# AQI Predictor - environment template.
# Copy to .env and fill in. Never commit the real .env.

# ---------------------------------------------------------------------------
# Storage backend selection
#   auto      MongoDB first, then Hopsworks, then bundled models/ (default)
#   mongo     MongoDB only
#   hopsworks Hopsworks only
# ---------------------------------------------------------------------------
STORAGE_BACKEND=auto

# --- PRIMARY STORE: MongoDB Atlas -----------------------------------------
# Feature store + model registry (artifacts held in GridFS).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=aqi_predictor

# --- SECONDARY STORE: Hopsworks -------------------------------------------
# Optional. Used only when MongoDB is unset or unreachable.
HOPSWORKS_API_KEY=
HOPSWORKS_PROJECT=

# Serve a model committed under models/ if no backend is reachable.
ALLOW_DISK_FALLBACK=true

# --- Location -------------------------------------------------------------
LATITUDE=25.3792
LONGITUDE=68.3683
TIMEZONE=Asia/Karachi
LOCATION_NAME=Hyderabad, Sindh

# --- Model selection ------------------------------------------------------
# Leave DEFAULT_MODEL blank to serve whichever model training flagged as best.
DEFAULT_MODEL=
MODEL_SELECTION_METRIC=val_rmse
MODEL_SELECTION_SORT=min
PREDICTION_DAYS=3

# --- API ------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_BASE_URL=http://localhost:8000
